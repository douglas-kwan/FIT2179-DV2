{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Black Summer vs. Typical Seasons: Selected States",
    "subtitle": "NSW and Victoria burned 20\u00d7 more than their seasonal average",
    "fontSize": 14,
    "subtitleFontSize": 11,
    "subtitleColor": "#888",
    "anchor": "start",
    "font": "Lato"
  },
  "width": "container",
  "height": 240,
  "data": {
    "url": "data/bs_vs_avg.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "color": "#ccc",
        "strokeWidth": 2.5
      },
      "encoding": {
        "x": {
          "field": "area_Mha",
          "type": "quantitative",
          "title": "Area Burned (Mha)",
          "axis": {
            "titleFontSize": 12,
            "labelFontSize": 11,
            "grid": true,
            "gridColor": "#eee"
          }
        },
        "y": {
          "field": "state",
          "type": "nominal",
          "title": null,
          "sort": [
            "New South Wales",
            "Victoria",
            "Queensland",
            "South Australia",
            "Tasmania"
          ],
          "axis": {
            "labelFontSize": 11
          }
        },
        "detail": {
          "field": "state"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 120,
        "strokeWidth": 0
      },
      "encoding": {
        "x": {
          "field": "area_Mha",
          "type": "quantitative"
        },
        "y": {
          "field": "state",
          "type": "nominal",
          "sort": [
            "New South Wales",
            "Victoria",
            "Queensland",
            "South Australia",
            "Tasmania"
          ]
        },
        "color": {
          "field": "period",
          "type": "nominal",
          "title": "Period",
          "scale": {
            "domain": [
              "Black Summer (2019\u201320)",
              "Avg Other Seasons"
            ],
            "range": [
              "#b30000",
              "#4e9a8e"
            ]
          },
          "legend": {
            "titleFontSize": 10,
            "labelFontSize": 9,
            "orient": "bottom",
            "direction": "horizontal"
          }
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "period",
            "title": "Period"
          },
          {
            "field": "area_Mha",
            "title": "Area Burned (Mha)",
            "format": ".3f"
          }
        ]
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "font": "Lato"
  },
  "autosize": {
    "type": "fit",
    "contains": "padding"
  }
}
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Black Summer Fire Impact by State & Territory",
    "subtitle": "Planned vs. Unplanned fires \u2014 total area burned in 2019\u201320",
    "fontSize": 14,
    "subtitleFontSize": 11,
    "subtitleColor": "#888",
    "anchor": "start",
    "font": "Lato"
  },
  "width": "container",
  "height": 300,
  "data": {
    "url": "data/black_summer_state_type.csv"
  },
  "params": [
    {
      "name": "state_sel",
      "select": {
        "type": "point",
        "fields": [
          "state"
        ]
      },
      "bind": "legend"
    }
  ],
  "mark": {
    "type": "bar",
    "cornerRadiusTopLeft": 3,
    "cornerRadiusTopRight": 3
  },
  "encoding": {
    "y": {
      "field": "state",
      "type": "nominal",
      "title": null,
      "sort": "-x",
      "axis": {
        "labelFontSize": 11,
        "labelLimit": 200
      }
    },
    "x": {
      "field": "area_Mha",
      "type": "quantitative",
      "title": "Area Burned (Mha)",
      "stack": "zero",
      "axis": {
        "titleFontSize": 12,
        "labelFontSize": 11,
        "grid": true,
        "gridColor": "#eee"
      }
    },
    "color": {
      "field": "fire_type",
      "type": "nominal",
      "title": "Fire Type",
      "scale": {
        "domain": [
          "Planned",
          "Unplanned"
        ],
        "range": [
          "#4e9a8e",
          "#d7552b"
        ]
      },
      "legend": {
        "titleFontSize": 11,
        "labelFontSize": 10,
        "orient": "bottom",
        "direction": "horizontal"
      }
    },
    "opacity": {
      "condition": {
        "param": "state_sel",
        "value": 1
      },
      "value": 0.2
    },
    "tooltip": [
      {
        "field": "state",
        "title": "State / Territory"
      },
      {
        "field": "fire_type",
        "title": "Fire Type"
      },
      {
        "field": "area_Mha",
        "title": "Area Burned (Mha)",
        "format": ".3f"
      },
      {
        "field": "area_ha",
        "title": "Area Burned (ha)",
        "format": ","
      }
    ]
  },
  "config": {
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "font": "Lato"
  },
  "autosize": {
    "type": "fit",
    "contains": "padding"
  }
}
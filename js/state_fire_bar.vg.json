{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Black Summer Fire Impact by State & Territory",
    "subtitle": "Planned vs. Unplanned fires — total area burned in 2019–20 (million ha)",
    "fontSize": 14, "subtitleFontSize": 11, "subtitleColor": "#888",
    "anchor": "start", "font": "Lato"
  },
  "width": "container",
  "height": 300,
  "autosize": {"type": "fit", "contains": "padding"},
  "data": {"url": "data/black_summer_state_type.csv"},
  "transform": [
    {
      "joinaggregate": [{"op": "sum", "field": "area_Mha", "as": "total_Mha"}],
      "groupby": ["state"]
    }
  ],
  "layer": [
    {
      "params": [
        {
          "name": "state_sel",
          "select": {"type": "point", "fields": ["state"]},
          "bind": "legend"
        }
      ],
      "mark": {"type": "bar", "cornerRadiusTopLeft": 3, "cornerRadiusTopRight": 3},
      "encoding": {
        "y": {
          "field": "state", "type": "nominal", "title": null,
          "sort": "-x",
          "axis": {"labelFontSize": 11, "labelLimit": 200}
        },
        "x": {
          "field": "area_Mha", "type": "quantitative",
          "title": "Area Burned (million ha)", "stack": "zero",
          "axis": {"titleFontSize": 12, "labelFontSize": 11, "grid": true, "gridColor": "#eee"}
        },
        "color": {
          "field": "fire_type", "type": "nominal", "title": "Fire Type",
          "scale": {"domain": ["Planned", "Unplanned"], "range": ["#4e9a8e", "#d7552b"]},
          "legend": {"titleFontSize": 11, "labelFontSize": 10, "orient": "bottom", "direction": "horizontal"}
        },
        "opacity": {
          "condition": {"param": "state_sel", "value": 1},
          "value": 0.2
        },
        "tooltip": [
          {"field": "state", "title": "State / Territory"},
          {"field": "fire_type", "title": "Fire Type"},
          {"field": "area_Mha", "title": "Area Burned (Mha)", "format": ".3f"}
        ]
      }
    },
    {
      "mark": {"type": "text", "align": "left", "dx": 4, "fontSize": 10, "fontWeight": "bold"},
      "encoding": {
        "y": {"field": "state", "type": "nominal", "sort": "-x"},
        "x": {"field": "total_Mha", "type": "quantitative"},
        "text": {"field": "total_Mha", "format": ".1f"},
        "color": {
          "condition": {"test": "datum.total_Mha > 5", "value": "#b30000"},
          "value": "#888"
        },
        "opacity": {
          "condition": {"param": "state_sel", "value": 1},
          "value": 0.2
        }
      },
      "transform": [{"filter": "datum.fire_type === 'Unplanned'"}]
    }
  ],
  "config": {"background": "transparent", "view": {"stroke": null}, "font": "Lato"}
}

{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "What Burned? Total Area by Vegetation Type (2019\u201320)",
    "subtitle": "Native forest suffered by far the greatest fire impact",
    "fontSize": 14,
    "subtitleFontSize": 11,
    "subtitleColor": "#888",
    "anchor": "start",
    "font": "Lato"
  },
  "width": "container",
  "height": 240,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "data": {
    "url": "data/fire_category_total.csv"
  },
  "transform": [
    {
      "calculate": "0",
      "as": "zero"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 2.5,
        "color": "#d9a87c"
      },
      "encoding": {
        "y": {
          "field": "category",
          "type": "nominal",
          "sort": {
            "field": "area_Mha",
            "order": "descending"
          },
          "title": null,
          "axis": {
            "labelFontSize": 11,
            "labelLimit": 200
          }
        },
        "x": {
          "field": "zero",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              24
            ]
          },
          "axis": null
        },
        "x2": {
          "field": "area_Mha",
          "type": "quantitative"
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 160,
        "opacity": 1
      },
      "encoding": {
        "y": {
          "field": "category",
          "type": "nominal",
          "sort": {
            "field": "area_Mha",
            "order": "descending"
          }
        },
        "x": {
          "field": "area_Mha",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              24
            ]
          },
          "title": "Total Area Burned (million ha)",
          "axis": {
            "titleFontSize": 12,
            "labelFontSize": 11,
            "grid": true,
            "gridColor": "#eee"
          }
        },
        "color": {
          "field": "area_Mha",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              21
            ],
            "range": [
              "#fdbb84",
              "#b30000"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "category",
            "title": "Vegetation Type"
          },
          {
            "field": "area_Mha",
            "title": "Area Burned (Mha)",
            "format": ".2f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "fontSize": 11,
        "fontWeight": "bold"
      },
      "encoding": {
        "y": {
          "field": "category",
          "type": "nominal",
          "sort": {
            "field": "area_Mha",
            "order": "descending"
          }
        },
        "x": {
          "field": "area_Mha",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              24
            ]
          }
        },
        "text": {
          "field": "label"
        },
        "color": {
          "condition": {
            "test": "datum.area_Mha > 10",
            "value": "#b30000"
          },
          "value": "#888"
        }
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "font": "Lato"
  }
}